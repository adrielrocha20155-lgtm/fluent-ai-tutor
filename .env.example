# Gemini API Key (Google AI Studio) - recommended for local development
GEMINI_API_KEY=your_api_key_here

# Gemini Live & Evaluation Models
MODEL=gemini-2.5-flash-native-audio-preview-09-2025
EVAL_MODEL=gemini-3.5-flash

# Optional: Google Cloud Vertex AI (used only if GEMINI_API_KEY is not set)
PROJECT_ID=your-project-id
LOCATION=us-central1

# Local Development Settings
DEV_MODE=true
SESSION_TIME_LIMIT=900
